# /gatemon/install/ID-LAPTOP  ->  index.php?id=ID-LAPTOP
# /gatemon/install/ID-LAPTOP/paket.zip (run.bat lama: dijawab 410)  ->  index.php?id=...&f=...
RewriteEngine On
RewriteRule ^([A-Za-z0-9_-]+)/?$ index.php?id=$1 [L,QSA]
RewriteRule ^([A-Za-z0-9_-]+)/(run\.bat|paket\.zip)$ index.php?id=$1&f=$2 [L,QSA]
