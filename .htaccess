# GateMon - pengamanan akses web (Apache 2.4)

# Jangan tampilkan daftar isi folder
Options -Indexes
DirectoryIndex index.php

# Folder repo git (.git/) berisi seluruh kode & riwayat: jangan pernah disajikan web
RedirectMatch 404 /\.git(/|$)

# File konfigurasi/library: hanya di-include PHP, tidak boleh dibuka langsung
<FilesMatch "^(config|config\.local|config\.local\.example|db|schema|security)\.php$">
    Require all denied
</FilesMatch>

# Dokumen, skrip, dan data yang tidak perlu disajikan web
<FilesMatch "\.(md|json|py|bat|reg|txt|log|ini|sql|bak|zip)$|^\.">
    Require all denied
</FilesMatch>

# setup.php memeriksa sendiri: hanya dari localhost, atau dengan setup_key di config.local.php

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
    Header unset X-Powered-By
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
